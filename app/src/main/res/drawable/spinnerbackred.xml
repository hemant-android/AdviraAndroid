<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape>

                    <stroke
                        android:width="2dp"
                        android:color="@color/colorRed" />
                    <corners
                        android:radius="2dp" />
                    <padding
                        android:left="3dp"
                        android:top="3dp"
                        android:right="3dp"
                        android:bottom="3dp" />
                    <solid
                        android:color="@color/colorWhite" />


                </shape>
            </item>
            <item
                android:top="0dp"
                android:right="10dp" >

                <bitmap android:src="@drawable/down_arrow"
                    android:gravity="center_vertical|right" />
            </item>
        </layer-list>
    </item>
</selector>