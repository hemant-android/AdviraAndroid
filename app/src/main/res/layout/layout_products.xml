<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_product"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:elevation="8dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="0.0px"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:cardElevation="8dp"
        android:layout_weight="1"
        app:cardPreventCornerOverlap="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:elevation="4dp"
            android:background="@drawable/shadowbackground">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="120dp"
                android:layout_height="100dp"
                android:padding="4dp"
                android:src="@drawable/advirahealnew" />

            <TextView
                android:id="@+id/tv_productid"
                style="@style/txt_style_heading3d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_cartproductid"
                style="@style/txt_style_heading3d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_rx"
                android:layout_width="12dp"
                android:layout_height="18dp"
                android:layout_below="@+id/imageView"
                android:layout_marginLeft="-2dp"
                android:src="@drawable/rx" />

            <TextView
                android:id="@+id/tv_productname"
                style="@style/txt_style_heading5d"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_below="@+id/imageView"
                android:layout_toEndOf="@+id/iv_rx"
                android:ellipsize="end"
                android:maxLines="2"
                 />

            <TextView
                android:id="@+id/tv_unitid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_composition"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_productname"
                android:layout_marginHorizontal="5dp"
                android:layout_marginLeft="10dp"
                android:text="Composition : "
                android:visibility="gone" />

            <TextView
                android:id="@+id/textViewShortDesc"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_composition"
                android:layout_alignParentStart="true"
                android:layout_marginHorizontal="5dp"
                android:layout_marginLeft="@dimen/dimen_10dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_packsize"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/textViewShortDesc"
                android:layout_alignParentStart="true"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Pack Size (10*10)" />

            <TextView
                android:id="@+id/tv_pack"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_below="@id/tv_packsize"
                android:layout_marginLeft="10dp"
                android:text="Strip 10 Tab"
                android:visibility="gone" />


            <TextView
                android:id="@+id/tv_mrp"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_pack"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                android:text="₹" />

            <TextView
                android:id="@+id/tv_mrpval"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_packsize"
                android:layout_marginTop="2dp"
                android:layout_toRightOf="@+id/tv_mrp"
                android:textColor="@color/colorGrey"
                android:text="80.00"
                />
            <TextView
                android:id="@+id/tv_discount"
                style="@style/txt_style_heading6m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_packsize"
                android:textSize="8dp"
                android:textColor="@color/colorPrimaryDark"
                android:layout_marginLeft="2dp"
                android:textStyle="bold"
                android:layout_toRightOf="@+id/tv_price"
                />

            <TextView
                android:id="@+id/tv_inr"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_packsize"
                android:layout_toRightOf="@+id/tv_mrpval"
                android:layout_marginLeft="@dimen/dimen_2dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/colorGrey"
                android:text="₹"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/tv_price"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_pack"
                android:layout_marginTop="2dp"
                android:layout_marginLeft="@dimen/dimen_2dp"
                android:layout_toRightOf="@+id/tv_inr"
                android:text="64.00"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/textViewRating"
                style="@style/txt_style_heading5l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryDark"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:paddingHorizontal="10dp"
                android:textColor="@color/colorWhite"/>

            <TextView
                android:id="@+id/tv_minqty"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_price"
                android:layout_marginLeft="15dp"
                android:text="Min order : 10"
                android:textAlignment="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_addremove"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_alignParentRight="true"
                android:layout_below="@id/tv_minqty"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone"
                android:weightSum="7">

                <Button
                    android:id="@+id/btn_decrease"
                    style="@style/txt_style_heading4d"
                    android:layout_width="80dp"
                    android:layout_height="30dp"
                    android:layout_weight="2"
                    android:background="@drawable/rounded_corner_gray_border"
                    android:backgroundTint="@color/colorPrimaryDark"
                    android:text="-"
                    android:textColor="@color/colorYellow"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/integer_number"
                    style="@style/txt_style_heading5d"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_weight="3"
                    android:background="@drawable/rounded_corner_gray_border"
                    android:digits="0123456789"
                    android:enabled="false"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="4"
                    android:text="1"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_increase"
                    style="@style/txt_style_heading4d"
                    android:layout_width="80dp"
                    android:layout_height="30dp"
                    android:layout_weight="2"
                    android:background="@drawable/rounded_corner_gray_border"
                    android:backgroundTint="@color/colorPrimaryDark"
                    android:text="+"
                    android:textColor="@color/colorYellow"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_addremovebutton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_30dp"
                android:layout_below="@id/tv_minqty"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_centerInParent="true"
                android:weightSum="7">

                <Button
                    android:id="@+id/btn_addto"
                    style="@style/txt_style_heading6d"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_weight="5"
                    android:background="@drawable/rounded_corner_gray_border"
                    android:text="ADD TO CART"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark" />

                <Button
                    android:id="@+id/btn_add"
                    style="@style/txt_style_heading4d"
                    android:layout_width="50dp"
                    android:layout_height="30dp"
                    android:layout_weight="2"
                    android:background="@drawable/rounded_corner_gray_border"
                    android:backgroundTint="@color/colorPrimaryDark"
                    android:text="+"
                    android:textColor="@color/colorYellow"
                    android:textStyle="bold"
                    />
            </LinearLayout>


            <Button
                android:id="@+id/btn_addtocart"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_below="@+id/ll_addremovebutton"
                android:layout_marginRight="5dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/button_selector"
                android:backgroundTint="@color/addcartbuttonbgcolor"
                android:paddingHorizontal="10dp"
                android:textColor="@color/colorBlack"
                android:text="ADD TO CART"
                android:visibility="gone" />


        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>