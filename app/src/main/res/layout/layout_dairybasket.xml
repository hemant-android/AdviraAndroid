<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="120dp"
                android:layout_height="100dp"
                android:padding="4dp"
                android:src="@drawable/advirahealnew" />
            <TextView
                android:id="@+id/tv_productid"
                style="@style/txt_style_heading3d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/iv_rx"
                android:layout_width="12dp"
                android:layout_height="18dp"
                android:layout_toRightOf="@+id/imageView"
                android:visibility="gone"
                android:src="@drawable/rx" />

            <TextView
                android:id="@+id/tv_productname"
                style="@style/txt_style_heading4d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/iv_rx"
                android:layout_marginLeft="3dp"
                android:text="Name" />
            <TextView
                android:id="@+id/tv_composition"
                style="@style/txt_style_heading6d"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_productname"
                android:layout_toRightOf="@+id/imageView"
                android:layout_marginHorizontal="5dp"
                android:text="details : " />

            <TextView
                android:id="@+id/textViewShortDesc"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_composition"
                android:layout_toRightOf="@+id/imageView"
                android:layout_marginHorizontal="5dp"
                android:text=" " />

            <TextView
                android:id="@+id/tv_packsize"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_toRightOf="@+id/imageView"
                android:layout_below="@id/textViewShortDesc"
                android:text="10kg" />


            <TextView
                android:id="@+id/tv_pack"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_alignParentStart="true"
                android:layout_marginLeft="15dp"
                android:layout_below="@id/imageView"
                android:text="Strip 10 Tab"
                />


            <TextView
                android:id="@+id/tv_mrp"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_packsize"
                android:layout_marginLeft="@dimen/dimen_5dp"
                android:layout_toRightOf="@id/imageView"
                android:text="Rate : ₹ " />

            <TextView
                android:id="@+id/tv_mrpval"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/tv_mrp"
                android:layout_below="@id/tv_packsize"
                android:text="80.00" />

            <TextView
                android:id="@+id/tv_discount"
                style="@style/txt_style_heading6m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_packsize"
                android:layout_marginLeft="2dp"
                android:layout_toRightOf="@+id/tv_price"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="8dp"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/tv_inr"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_packsize"
                android:visibility="gone"
                android:layout_toRightOf="@+id/tv_mrpval"
                android:text=" ₹" />

            <TextView
                android:id="@+id/tv_price"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_packsize"
                android:layout_toRightOf="@+id/tv_inr"
                android:text="64.00"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_unitid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textViewRating"
                style="@style/txt_style_heading5l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/colorThemeDark"
                android:textColor="@color/colorWhite"
                android:paddingHorizontal="10dp"/>

            <TextView
                android:id="@+id/tv_minqty"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_price"
                android:visibility="gone"
                android:layout_marginLeft="15dp"
                android:text="Min order : 10"
                android:textAlignment="center" />

            <LinearLayout
                android:id="@+id/ll_addremove"
                android:layout_width="120dp"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:layout_below="@id/tv_minqty"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_alignParentRight="true"
                android:weightSum="7">

                <Button
                    android:id="@+id/btn_decrease"
                    style="@style/txt_style_heading4d"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="2"
                    android:background="@drawable/rounded_corner_gray_border"
                    android:backgroundTint="@color/colorPrimaryDark"
                    android:text="-"
                    android:textColor="@color/colorYellow"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/integer_number"
                    style="@style/txt_style_heading5d"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:enabled="false"
                    android:layout_weight="3"
                    android:digits="0123456789"
                    android:textColor="@color/colorPrimaryDark"
                    android:backgroundTint="@color/colorYellow"
                    android:background="@drawable/rounded_corner_gray_border"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="4"
                    android:text="1"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_increase"
                    style="@style/txt_style_heading4d"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="2"
                    android:textColor="@color/colorYellow"
                    android:backgroundTint="@color/colorPrimaryDark"
                    android:background="@drawable/rounded_corner_gray_border"
                    android:text="+"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_addremovebutton"
                android:layout_width="140dp"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:layout_below="@id/tv_minqty"
                android:orientation="horizontal"
                android:layout_alignParentRight="true"
                android:weightSum="7">

                <Button
                    android:id="@+id/btn_addto"
                    style="@style/txt_style_heading6d"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:textColor="@color/colorPrimaryDark"
                    android:layout_weight="5"
                    android:layout_gravity="center"
                    android:textStyle="bold"
                    android:background="@drawable/rounded_corner_gray_border"
                    android:text="ADD "/>

                <Button
                    android:id="@+id/btn_add"
                    style="@style/txt_style_heading4d"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:textColor="@color/colorYellow"
                    android:backgroundTint="@color/colorPrimaryDark"
                    android:background="@drawable/rounded_corner_gray_border"
                    android:layout_weight="2"
                    android:text="+"
                    android:layout_gravity="center"
                    android:textStyle="bold" />
            </LinearLayout>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>