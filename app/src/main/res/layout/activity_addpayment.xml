<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.order.AddPaymentActivity">

    <RelativeLayout
        android:id="@+id/rl_adpayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header">

        <RelativeLayout
            android:id="@+id/rl_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_effect"
            android:paddingLeft="5dp"
            >

            <ImageView
                android:id="@+id/iv_signup_header"
                style="@style/txt_style_heading1l"
                android:layout_width="@dimen/dimen_20dp"
                android:layout_height="@dimen/dimen_20dp"
                android:layout_marginHorizontal="@dimen/dimen_15dp"
                android:layout_marginVertical="16dp"
                android:src="@drawable/ic_arrow_back_24dp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_pd_header2"
            style="@style/txt_style_heading4l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingBottom="@dimen/dimen_2dp"
            android:layout_toRightOf="@id/rl_back"
            android:textColor="@color/colorPrimaryDark"
            android:text="Add Payment" />



    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_loginmain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/rl_adpayment"
        android:layout_marginHorizontal="15dp">



        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/rl_login2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerVertical="true">




                <TextView
                    android:id="@+id/tv_msg"
                    style="@style/txt_style_heading4l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:text="Please add payment details for your Order # " />


                <TextView
                    android:id="@+id/tv_paymentpending"
                    style="@style/txt_style_heading4l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_msg"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    android:text="Payment Pending ₹ " />


                <RelativeLayout
                    android:id="@+id/rl_payment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_paymentpending"
                    android:layout_marginVertical="10dp"
                    android:background="@drawable/border_bg_color_transparent"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_paymentdetails"
                        style="@style/txt_style_heading3l"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Please enter payment details below :"
                        android:textColor="@color/colorBlack" />

                    <TextView
                        android:id="@+id/tv_paymenttype"
                        style="@style/txt_style_heading4l"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_paymentdetails"
                        android:layout_marginTop="10dp"
                        android:text="Payment Type"
                        android:textColor="@color/colorBlack" />

                    <RadioGroup
                        android:id="@+id/rg_paymenttype"
                        style="@style/txt_style_heading4l"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_paymenttype"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <RadioButton
                            android:id="@+id/rb_full"
                            style="@style/txt_style_heading4l"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:fontFamily="@font/montserrat"
                            android:text="Full"
                            android:textColor="@color/colorBlack" />

                        <RadioButton
                            android:id="@+id/rb_partial"
                            style="@style/txt_style_heading4l"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="false"
                            android:fontFamily="@font/montserrat"
                            android:text="Partial"
                            android:textColor="@color/colorBlack" />

                        <RadioButton
                            android:id="@+id/rb_credit"
                            style="@style/txt_style_heading4l"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="false"
                            android:fontFamily="@font/montserrat"
                            android:text="Minimum"
                            android:textColor="@color/colorBlack" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/tv_paymentamount"
                        style="@style/txt_style_heading4l"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/rg_paymenttype"
                        android:layout_marginTop="10dp"
                        android:text="Payment Amount"
                        android:textColor="@color/colorBlack" />

                    <EditText
                        android:id="@+id/et_paymentamount"
                        style="@style/txt_style_heading4l"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_paymentamount"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/border_bg_color_mid"
                        android:digits="1234567890"
                        android:inputType="number"
                        android:hint="Enter Amount"
                        android:maxLength="10"
                        android:padding="8dp"
                        android:textColorHint="@color/colorThemeLight" />

                    <TextView
                        android:id="@+id/tv_paymentmode"
                        style="@style/txt_style_heading4l"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/et_paymentamount"
                        android:layout_marginTop="10dp"
                        android:text="Payment Mode"
                        android:textColor="@color/colorBlack"
                        android:visibility="gone"/>

                    <Spinner
                        android:id="@+id/spn_paymentmode"
                        style="@style/txt_style_heading4l"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_alignParentLeft="true"
                        android:layout_below="@id/tv_paymentmode"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/spinnerback"
                        android:visibility="gone"/>
                </RelativeLayout>


                <TextView
                    android:id="@+id/tv_payment"
                    style="@style/txt_style_heading4l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rl_payment"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    android:text="In order to process payment please find below account details"
                    android:textColor="@color/colorBlack" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_payment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_payment"
                    android:layout_marginVertical="20dp">


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_bankdetails"
                            style="@style/txt_style_heading5d"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text=" Company’s Bank Details"
                            android:textStyle="bold" />


                        <View
                            android:id="@+id/v_line21"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_below="@id/tv_bankdetails"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="10dp"
                            android:background="@color/colorThemeLight" />

                        <TextView
                            android:id="@+id/tv_accname"
                            style="@style/txt_style_heading5d"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/v_line21"
                            android:layout_marginTop="10dp"
                            android:layout_marginLeft="10dp"
                            android:text="A/c Name : Advira Technomanagement Pvt. Ltd."  />
                        <TextView
                            android:id="@+id/tv_bankacno"
                            style="@style/txt_style_heading5d"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tv_accname"
                            android:layout_marginLeft="10dp"
                            android:text="A/c No. : 630305012399" />
                        <TextView
                            android:id="@+id/tv_bankifsc"
                            style="@style/txt_style_heading5d"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tv_bankacno"
                            android:layout_marginLeft="10dp"
                            android:text="Branch &amp; IFS Code : ICIC0006303"/>

                        <TextView
                            android:id="@+id/tv_bankname"
                            style="@style/txt_style_heading5d"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tv_bankifsc"
                            android:layout_marginBottom="10dp"
                            android:layout_marginLeft="10dp"
                            android:text="Bank Name : ICICI Bank"  />


                    </RelativeLayout>
                </androidx.cardview.widget.CardView>


                <Button
                    android:id="@+id/btn_continueshopping"
                    style="@style/txt_style_heading2d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/cv_payment"
                    android:layout_centerHorizontal="true"
                    android:layout_marginVertical="20dp"
                    android:background="@drawable/button_selector"
                    android:text="SUBMIT"
                    android:textColor="@color/colorYellow"
                    android:textStyle="bold" />


            </RelativeLayout>

        </ScrollView>
    </RelativeLayout>
</RelativeLayout>
