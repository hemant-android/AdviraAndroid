<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"

    tools:context=".ui.registration.mobileotp.MobileOTPActivity">


    <RelativeLayout
        android:id="@+id/rl_otp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header">

        <RelativeLayout
            android:id="@+id/rl_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_effect"
            android:paddingLeft="5dp"
            >

            <ImageView
                android:id="@+id/iv_signup_header"
                style="@style/txt_style_heading1l"
                android:layout_width="@dimen/dimen_20dp"
                android:layout_height="@dimen/dimen_20dp"
                android:layout_marginHorizontal="@dimen/dimen_15dp"
android:layout_marginVertical="16dp"
android:src="@drawable/ic_arrow_back_24dp" />
        </RelativeLayout>


        <TextView
            android:id="@+id/tv_signup_header2"
            style="@style/txt_style_heading4d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingBottom="@dimen/dimen_2dp"
            android:layout_toRightOf="@id/rl_back"
            android:textColor="@color/colorPrimaryDark"
            android:text="@string/otp_header" />

    </RelativeLayout>

    <ScrollView
        android:id="@+id/rl_signup2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rl_otp"
        android:layout_centerVertical="true">

    <RelativeLayout
        android:id="@+id/rl_otpmain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rl_otp"
        android:layout_centerVertical="true"
        android:layout_marginVertical="@dimen/dimen_10dp"
        android:layout_marginHorizontal="25dp">


        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="265dp"
            android:layout_height="50dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:src="@drawable/advirahealnew"
            />

        <TextView
            android:id="@+id/tv_verify"
            style="@style/txt_style_heading2l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_logo"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/montserrat"
            android:gravity="start"
            android:text="@string/otp_verify"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_emailemail"
            style="@style/txt_style_heading4d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_verify"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/montserrat"
            android:gravity="start"
            android:text="@string/otp_sms" />

        <TextView
            android:id="@+id/tv_mobile"
            style="@style/txt_style_heading4l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_emailemail"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/montserrat"
            android:gravity="center_horizontal"
            android:textStyle="bold"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_email"
            style="@style/txt_style_heading4l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_mobile"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/montserrat"
            android:gravity="center_horizontal"
            android:textStyle="bold"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_entersms"
            style="@style/txt_style_heading3d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_email"
            android:layout_marginTop="20dp"
            android:text="@string/otp_mobotp" />

        <EditText
            android:id="@+id/et_mobileotp"
            style="@style/txt_style_heading4l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_entersms"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:padding="@dimen/dimen_15dp"
            android:gravity="center"
            android:layout_weight="1"
            android:hint="Enter 4 digit OTP"
            android:inputType="number"
            android:background="@drawable/editbox_selector"
            android:maxLength="4"
            android:textAlignment="center" />

        <RelativeLayout
            android:id="@+id/resend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/et_mobileotp"
            android:gravity="start"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/tv_didnotmod"
                style="@style/txt_style_heading6d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="@string/otp_didnotmob" />

            <TextView
                android:id="@+id/tv_resendmobotp"
                style="@style/txt_style_heading6l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_toEndOf="@id/tv_didnotmod"
                android:text="@string/otp_resend"
                android:textColor="@color/colorPrimaryDark"
                android:textStyle="bold" />

        </RelativeLayout>

        </RelativeLayout>
    </ScrollView>
    <RelativeLayout
        android:id="@+id/rl_footer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/dimen_25dp"
        >

        <Button
            android:id="@+id/btn_verifynow"
            style="@style/txt_style_heading2d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:textSize="14sp"
            android:background="@drawable/button_selector"
            android:gravity="center"
            android:text="Verify"
            android:textColor="@color/colorYellow"
            android:textStyle="bold"/>
</RelativeLayout>
</RelativeLayout>