<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/rl_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">


                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="120dp"
                    android:layout_height="100dp"
                    android:padding="4dp"
                    android:src="@drawable/advirahealnew" />

                <ImageView
                    android:id="@+id/iv_rx"
                    android:layout_width="12dp"
                    android:layout_height="18dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginLeft="-1dp"
                    android:layout_marginTop="-3dp"
                    android:layout_toEndOf="@+id/imageView"
                    android:visibility="gone"
                    android:src="@drawable/rx" />

                <TextView
                    android:id="@+id/tv_productname"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_toRightOf="@id/imageView"
                    android:text="ADVINAC-SP" />


                <TextView
                    android:id="@+id/tv_pack"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_productname"
                    android:layout_marginLeft="10dp"
                    android:layout_toRightOf="@id/imageView"
                    android:text="Strip 10 Tab" />

                <TextView
                    android:id="@+id/tv_mrp"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_pack"
                    android:layout_toRightOf="@id/imageView"
                    android:layout_marginLeft="10dp"
                    android:text="Rate : ₹ "
                    />

                <TextView
                    android:id="@+id/tv_prodid"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_boxsize"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_unitid"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />


                <TextView
                    android:id="@+id/tv_mrpval"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_pack"
                    android:layout_toRightOf="@id/tv_mrp"
                    android:text="80.00"
                    />

                <TextView
                    android:id="@+id/tv_discount"
                    style="@style/txt_style_heading6m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_pack"
                    android:layout_marginLeft="4dp"
                    android:layout_toRightOf="@+id/tv_price"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="8dp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:id="@+id/tv_inr"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_pack"
                    android:layout_toRightOf="@id/tv_mrpval"
                    android:text=" ₹"
                    android:visibility="gone"
                    />

                <TextView
                    android:id="@+id/tv_price"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_pack"
                    android:layout_toRightOf="@id/tv_inr"
                    android:text="64.00" />


                <TextView
                    android:id="@+id/tv_orderqty"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/tv_mrp"
                    android:layout_below="@id/tv_price"
                    android:text="Order Qty : " />

                <TextView
                    android:id="@+id/tv_orderqtyval"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_price"
                    android:layout_toRightOf="@id/tv_orderqty"
                    android:text="10" />

                <TextView
                    android:id="@+id/tv_orderqtyunit"
                    style="@style/txt_style_heading6d"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_price"
                    android:layout_toRightOf="@id/tv_orderqtyval"
                    android:layout_marginLeft="5dp"
                    android:text="Box" />


                <TextView
                    android:id="@+id/tv_itemprice"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@+id/tv_orderqty"
                    android:layout_below="@id/tv_orderqty"
                    android:text="Total Amount : ₹ " />

                <TextView
                    android:id="@+id/tv_itempriceval"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_orderqty"
                    android:layout_toRightOf="@id/tv_itemprice"
                    android:text="64.00"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/tv_stock"
                    style="@style/txt_style_heading5l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/imageView"
                    android:background="@color/colorThemeDark"
                    android:paddingHorizontal="10dp"
                    android:text="In Stock"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_minqty"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_below="@id/imageView"
                    android:text="Min order : 10"
                    android:textAlignment="center"
                    android:visibility="gone" />



            </RelativeLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>