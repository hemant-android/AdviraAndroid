                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/v_line111"
                android:layout_marginHorizontal="0dp"
                android:background="@color/colorWhite"
                android:visibility="gone"
                >

                <TextView
                    android:id="@+id/tv_addbusinessdetails"
                    style="@style/txt_style_heading5d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dimen_10dp"
                    android:text="Add Business Details"
                    android:drawableEnd="@drawable/ic_arrow_right_blue_24dp"
                    android:drawablePadding="@dimen/dimen_5dp"/>

            </RelativeLayout>

            <View
                android:id="@+id/v_line101"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_below="@id/rl_addbusiness"
                android:background="@color/colorGreyVerylight"
                android:visibility="gone"/>

        <RelativeLayout
            android:id="@+id/rl_membership"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/v_line101"
            android:layout_marginHorizontal="0dp"
            android:visibility="gone"
            android:background="@color/borderlinecolor"
            >
            <TextView
                android:id="@+id/tv_membership"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Membership"
                android:textAllCaps="true"
                android:padding="@dimen/dimen_5dp"
                android:textColor="@color/black"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_membership"
                android:layout_below="@+id/tv_membership"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="@dimen/dimen_10dp"
                android:layout_marginEnd="10dp"
                android:background="@color/borderlinecolor"
                android:clipToPadding="true"
                app:cardCornerRadius="5dp"
                android:padding="@dimen/dimen_10dp"
                app:cardUseCompatPadding="true">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/borderlinecolor">

                <TextView
                    android:id="@+id/tv_content1"
                    style="@style/txt_style_heading3d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/dimen_5dp"
                    android:background="@color/borderlinecolor"
                    android:text="Get Membership at Rs.299/Year"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/tv_content2"
                    android:layout_below="@+id/tv_content1"
                    style="@style/txt_style_heading4d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/dimen_5dp"
                    android:background="@color/borderlinecolor"
                    android:text="Membership Valid For Next 1 Year"
                    android:gravity="center"/>

                <Button
                    android:id="@+id/btn_upgradeplan"
                    android:layout_below="@+id/tv_content2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Join Now"
                    android:layout_marginTop="@dimen/dimen_5dp"
                    android:background="@drawable/button_selector"
                    android:textColor="@color/colorYellow"
                    android:padding="@dimen/dimen_5dp"/>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>


        </RelativeLayout>


        </RelativeLayout>

    </ScrollView>

    <RelativeLayout
        android:id="@+id/rl_footer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/dimen_20dp"
        android:background="@color/colorWhite"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_login"
            style="@style/txt_style_heading3d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/button_selector"
            android:text="Login Now"
            android:textColor="@color/colorYellow"
            android:textStyle="bold" />

    </RelativeLayout>


</RelativeLayout>