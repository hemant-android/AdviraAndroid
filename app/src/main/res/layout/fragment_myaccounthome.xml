                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Company Email" />


                                <TextView
                                    android:id="@+id/tv_companymailval"
                                    style="@style/txt_style_heading5d"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColor="@color/colorGreymidlight" />


                            </LinearLayout>

