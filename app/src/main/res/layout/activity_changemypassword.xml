<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.forgotpassword.PasswordChangeActivity">


    <RelativeLayout
        android:id="@+id/rl_otp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header">

        <RelativeLayout
            android:id="@+id/rl_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_effect"
            android:paddingLeft="5dp"
            >

            <ImageView
                android:id="@+id/iv_signup_header"
                style="@style/txt_style_heading1l"
                android:layout_width="@dimen/dimen_20dp"
                android:layout_height="@dimen/dimen_20dp"
                android:layout_marginVertical="16dp"
                android:layout_marginHorizontal="@dimen/dimen_15dp"
                android:src="@drawable/ic_arrow_back_24dp" />
        </RelativeLayout>


        <TextView
            android:id="@+id/tv_signup_header2"
            style="@style/txt_style_heading4l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingBottom="@dimen/dimen_2dp"
             android:layout_toRightOf="@id/rl_back"
            android:text="@string/fp_headertop"
            android:textColor="@color/colorPrimaryDark"/>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_loginmain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/rl_otp"
        android:layout_marginHorizontal="25dp">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="265dp"
            android:layout_height="50dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="25dp"
            android:src="@drawable/advirahealnew"
            android:visibility="invisible"/>


        <RelativeLayout
            android:id="@+id/rl_login2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_25dp"
            android:layout_below="@+id/iv_logo">
            <TextView
                android:id="@+id/tv_otpverified"
                style="@style/txt_style_heading3l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/montserrat"
                android:textStyle="bold"
                android:text="Please enter passwords below" />

            <TextView
                android:id="@+id/tv_password"
                style="@style/txt_style_heading3l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_otpverified"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/montserrat"
                android:text="@string/fp_newpassword"
                />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_password"
                android:autofillHints="@string/prompt_password"
                android:drawableEnd="@drawable/ic_visibility_off_24dp"
                android:drawableStart="@drawable/ic_lock_24dp"
                android:drawablePadding="5sp"
                android:drawableRight="@drawable/ic_visibility_off_24dp"
                android:drawableLeft="@drawable/ic_lock_24dp"
                android:hint="min. 8 characters"
                android:imeActionLabel="@string/action_sign_in_short"
                android:imeOptions="actionDone"
                style="@style/txt_style_heading4l"
                android:layout_marginTop="10dp"
                android:inputType="textPassword"
                android:background="@drawable/editbox_selector"
                android:padding="@dimen/dimen_10dp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tv_password2"
                style="@style/txt_style_heading3l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/et_password"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/montserrat"
                android:text="@string/fp_confirmpass" />

            <EditText
                android:id="@+id/et_password2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_password2"
                android:autofillHints="@string/prompt_password"
                android:drawableEnd="@drawable/ic_visibility_off_24dp"
                android:drawableLeft="@drawable/ic_lock_24dp"
                android:drawablePadding="5sp"
                android:drawableRight="@drawable/ic_visibility_off_24dp"
                android:drawableStart="@drawable/ic_lock_24dp"
                android:hint="min. 8 characters"
                android:imeActionLabel="@string/action_sign_in_short"
                android:imeOptions="actionDone"
                style="@style/txt_style_heading4l"
                android:layout_marginTop="10dp"
                android:inputType="textPassword"
                android:background="@drawable/editbox_selector"
                android:padding="@dimen/dimen_10dp"
                android:gravity="center"
                />


            <Button
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/et_password2"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="230dp"
                android:background="@drawable/button_selector"
                android:text="@string/fp_submit"
                style="@style/txt_style_heading2d"
                android:textColor="@color/colorYellow"
                android:textStyle="bold"/>


            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_submit"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="30dp">


            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
