<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ffffff">

    <ImageView
        android:id="@+id/adviralogo"
        android:layout_width="176dp"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/dp_48"
        android:layout_centerHorizontal="true"
        app:layout_constraintVertical_bias="0.110000014"
        app:srcCompat="@drawable/advirahealnew" />

    <ImageView
        android:id="@+id/vegetables_1"
        android:layout_below="@+id/adviralogo"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_centerVertical="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/dp_48"
        app:srcCompat="@drawable/vegetables_1" />

    <TextView
        android:id="@+id/title"
        android:layout_below="@+id/vegetables_1"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Create Farm Tokri"
        android:textColor="@color/colorBlack"
        android:textSize="25sp"
        android:gravity="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />

    <TextView
        android:id="@+id/desc"
        android:layout_below="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_32"
        android:textColor="@color/colorBlack"
        android:gravity="center"
        android:layout_marginLeft="@dimen/dimen_30dp"
        android:layout_marginRight="@dimen/dimen_30dp"
        android:textSize="18sp"
        android:text="@string/description2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title" />

    <LinearLayout
        android:id="@+id/layout2"
        android:layout_below="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="@dimen/dp_64"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/ind1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ind2"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/desc"
            app:srcCompat="@drawable/seleted" />

        <ImageView
            android:id="@+id/ind2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/ind1"
            app:layout_constraintEnd_toStartOf="@+id/ind3"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/ind1"
            app:layout_constraintTop_toTopOf="@+id/ind1"
            app:srcCompat="@drawable/seleted" />

        <ImageView
            android:id="@+id/ind3"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/ind2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/ind2"
            app:layout_constraintTop_toTopOf="@+id/ind2"
            app:srcCompat="@drawable/seleted" />
    </LinearLayout>

    <ImageView
        android:id="@+id/back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_below="@+id/vegetables_1"
        android:layout_marginLeft="46dp"
        android:layout_toLeftOf="@+id/vegetables_1"
        android:layout_marginRight="@dimen/dp_48"
        app:srcCompat="@drawable/ic_back"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_toRightOf="@+id/vegetables_1"
        android:layout_below="@+id/vegetables_1"
        app:srcCompat="@drawable/ic_next"
        android:visibility="gone"/>


</RelativeLayout>