<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">


  <!--  <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="30dp"
        android:src="@drawable/advirahealnew"
        android:layout_above="@id/splashcircle"/>-->




  <ImageView
      android:id="@+id/splashcircle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:alpha="0.4"
      android:layout_centerInParent="true"
      android:src="@drawable/splash_circleborder" />



  <ImageView
      android:id="@+id/tv_circle"
      android:layout_width="225dp"
      android:layout_height="225dp"
      android:layout_centerInParent="true"
      android:background="@drawable/splash_circleborder"/>

  <ImageView
      android:id="@+id/splashscreen"
      android:layout_width="140dp"
      android:layout_height="130dp"
      android:layout_centerInParent="true"
      android:src="@drawable/splash_logo" />

  <TextView
      android:id="@+id/tv_connectingdots"
      style="@style/txt_style_heading5m"
      android:textColor="@color/colorStatusbar"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerHorizontal="true"
      android:textStyle="italic"
      android:layout_below="@id/tv_circle"
      android:layout_marginTop="10dp"
      android:fontFamily="@font/montserrat"
      android:text="Connecting Dots" />


  <com.agrawalsuneet.dotsloader.loaders.LinearDotsLoader
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:layout_centerHorizontal="true"
      android:layout_below="@id/tv_connectingdots"
      android:layout_marginTop="20dp"
      app:loader_animDur="500"
      app:loader_noOfDots="6"
      app:loader_circleRadius="4dp"
      app:loader_defaultColor="@color/colorYellow"
      app:loader_selectedColor="@color/colorOrageNew"
      app:loader_dotsDist="10dp"
      app:loader_expandOnSelect="false"
      app:loader_isSingleDir="false"
      app:loader_selectedRadius="10dp"
      app:loader_showRunningShadow="true"
      app:loader_firstShadowColor="@color/colorRed"
      app:loader_secondShadowColor="@color/colorPurple" />

</RelativeLayout>