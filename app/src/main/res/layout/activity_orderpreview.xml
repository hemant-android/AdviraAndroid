<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorGreyVerylight"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rl_carthome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header">

        <RelativeLayout
            android:id="@+id/rl_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_effect"
            android:paddingLeft="5dp"
            >

            <ImageView
                android:id="@+id/iv_signup_header"
                style="@style/txt_style_heading1l"
                android:layout_width="@dimen/dimen_20dp"
                android:layout_height="@dimen/dimen_20dp"
                android:layout_marginHorizontal="@dimen/dimen_15dp"
android:layout_marginVertical="16dp"
android:src="@drawable/ic_arrow_back_24dp" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/iv_headerlogo"
            style="@style/txt_style_heading1l"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_toRightOf="@id/rl_back"
            android:layout_marginLeft="10dp"
            android:layout_marginVertical="15dp"
            android:src="@drawable/splash_logo"
            android:visibility="gone"/>


        <TextView
            android:id="@+id/tv_pd_header2"
            style="@style/txt_style_heading4d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingBottom="@dimen/dimen_2dp"
            android:layout_toRightOf="@id/iv_headerlogo"
            android:text="Order Summary"
            android:textColor="@color/colorPrimaryDark"/>

        <RelativeLayout
            android:id="@+id/rl_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_effect"
            android:layout_toLeftOf="@id/rl_cart"
            android:visibility="gone"
            android:layout_marginRight="20dp"
            android:layout_marginVertical="15dp">
            <ImageView
                android:id="@+id/iv_search"
                style="@style/txt_style_heading1l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/colorBlack"
                android:src="@drawable/ic_search_button_select" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_effect"
            android:layout_alignParentRight="true"
            android:visibility="gone"
            android:layout_marginRight="20dp"
            android:layout_marginVertical="15dp">

            <ImageView
                android:id="@+id/iv_cart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_shopping_cart_24dp"
                android:tint="@color/colorBlack"/>

        </RelativeLayout>
        <TextView
            android:id="@+id/tv_cartcount"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="-25dp"
            android:visibility="gone"
            android:layout_toStartOf="@+id/rl_cart"
            android:fontFamily="@font/montserrat"
            android:gravity="center"
            android:textColor="@color/colorRed"
            android:textSize="10dp"
            android:textStyle="bold"/>
    </RelativeLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_56"
        android:layout_below="@id/rl_carthome">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/ll_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorWhite"
                android:paddingHorizontal="10dp"

                android:paddingVertical="5dp"

                >


                <TextView
                    android:id="@+id/tv_addid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_delivaddress"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginTop="10dp"
                    android:text="Delivery Address"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_clientname"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_delivaddress"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_client_addresstype"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_delivaddress"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginTop="10dp"
                    android:layout_toEndOf="@id/tv_clientname"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_pinval"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_clientname"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/bg_corners_border_dotted_blue"
                    android:padding="@dimen/dimen_10dp" />


                <Button
                    android:id="@+id/btn_change"
                    style="@style/txt_style_heading5d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_pinval"
                    android:layout_marginVertical="15dp"
                    android:background="@drawable/button_selector"
                    android:text="CHANGE OR ADD NEW ADDRESS "
                    android:textColor="@color/colorYellow"
                    android:textStyle="bold" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_membershipAds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_header"
                android:layout_marginHorizontal="@dimen/dimen_10dp"
                android:padding="@dimen/dimen_5dp"
                android:background="@color/colorPrimaryDark">

                <TextView
                    android:id="@+id/tv_adstitle"
                    style="@style/txt_style_heading5l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:textColor="@color/colorWhite"
                    android:layout_marginLeft="5dp"
                    android:text="ADVIRA Elite Green"
                    android:textStyle="bold|italic"
                    />

                <TextView
                    android:id="@+id/tv_adsname"
                    style="@style/txt_style_heading6l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_below="@id/tv_adstitle"
                    android:textColor="@color/colorYellow"
                    android:layout_marginLeft="5dp"
                    android:textStyle="italic"
                    android:text="To get more benefits Join Membership"

                    />

                <TextView
                    android:id="@+id/tv_buyplan"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_marginHorizontal="@dimen/dimen_5dp"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:textColor="@color/colorPrimaryDark"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="@dimen/dimen_5dp"
                    android:text="Join Now"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/border_grey_color_transparent"
                    android:backgroundTint="@color/colorYellow"
                    />

                <CheckBox android:id="@+id/checkbox_cheese"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/colorYellow"
                    android:layout_alignParentRight="true"
                    android:visibility="gone"
                    />
            </RelativeLayout>





            <TextView
                android:id="@+id/tv_rv1"
                style="@style/txt_style_heading3d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginVertical="10dp"
                android:layout_below="@+id/rl_membershipAds"
                android:text="" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_rv1"
                android:scrollbars="none">

            </androidx.recyclerview.widget.RecyclerView>



            <RelativeLayout
                android:id="@+id/rl_coupon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/recyclerView"
                android:padding="5dp"
                android:layout_marginTop="10dp"
                android:background="@color/colorWhite"
                android:visibility="gone">


                <TextView
                    android:id="@+id/tv_applycoupon"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="5dp"
                    android:text="Offers "
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/tv_selectdiscount"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_applycoupon"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="5dp"
                    android:text="View offers"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"/>

                <EditText
                    android:id="@+id/et_couponcode"
                    style="@style/txt_style_heading5l"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_selectdiscount"
                    android:layout_alignParentLeft="true"
                    android:layout_marginTop="10dp"
                    android:singleLine="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:background="@drawable/addtocart_button_selector"
                    android:backgroundTint="@color/colorGreymidlight"
                    android:hint="Enter Couponcode"
                    android:padding="@dimen/dimen_5dp" />

                <Button
                    android:id="@+id/btn_apply"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/border_grey_color_transparent"
                    android:backgroundTint="@color/colorYellow"
                    android:layout_toRightOf="@id/et_couponcode"
                    android:layout_below="@id/tv_selectdiscount"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="10dp"
                    android:text="Apply"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btn_remove"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/border_grey_color_transparent"
                    android:backgroundTint="@color/colorYellow"
                    android:layout_toRightOf="@id/et_couponcode"
                    android:layout_below="@id/tv_selectdiscount"
                    android:visibility="gone"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="10dp"
                    android:text="Remove"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold"/>


            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_content2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/rl_coupon"
                android:layout_marginVertical="10dp"
                android:background="@color/colorWhite"
                >


                <TextView
                    android:id="@+id/tv_pricedetail"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/cd_pricedetails" />


                <View
                    android:id="@+id/v_line2"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_below="@id/tv_pricedetail"
                    android:layout_marginVertical="10dp"
                    android:background="@color/colorGreyVerylight" />

                <TextView
                    android:id="@+id/tv_price"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/v_line2"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:text="Price Total"
                    android:textColor="@color/colorGreylight"/>

                <TextView
                    android:id="@+id/tv_priceval"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_below="@id/v_line2"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="10dp"
                    android:text="" />

                <TextView
                    android:id="@+id/tv_discount"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_price"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:text="Discount" />

                <TextView
                    android:id="@+id/tv_discountval"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_below="@id/tv_price"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="10dp"
                    android:text="₹" />

                <TextView
                    android:id="@+id/tv_gst"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_discount"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    android:text="GST Total" />

                <TextView
                    android:id="@+id/tv_gstval"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_below="@id/tv_discount"
                    android:layout_marginLeft="10dp"
                    android:visibility="gone"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="10dp"
                    android:text="" />

                <TextView
                    android:id="@+id/tv_delivery"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_gst"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:text="Delivery Charges (i)" />

                <TextView
                    android:id="@+id/tv_deliveryval"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_below="@id/tv_gst"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textColor="@color/colorGreen" />

                <View
                    android:id="@+id/v_line3"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_below="@id/tv_delivery"
                    android:layout_marginVertical="10dp"
                    android:background="@color/colorGreyVerylight" />

                <TextView
                    android:id="@+id/tv_totalpaid"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/v_line3"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:text="To be paid"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_totalpaidval"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_below="@id/v_line3"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_totalsavings"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_totalpaid"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="10dp"
                    android:text="Total Savings"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_totalsavingsval"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_totalpaid"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="10dp"
                    android:layout_toRightOf="@id/tv_totalsavings"
                    android:text=""
                    android:textColor="@color/colorGreen"
                    android:textStyle="bold"
                    android:visibility="gone" />


                <TextView
                    android:id="@+id/tv_discountid"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_totalpaid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_discount_coupon_name"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_totalpaid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_discount_type"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_totalpaid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_discount_amount"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_totalpaid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_discount_details"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_totalpaid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_credit_limit"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_totalpaid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_credit_availed"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_totalpaid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_credit_balance"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_totalpaid"
                    android:visibility="gone" />


                <View
                    android:id="@+id/v_line6"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_10dp"
                    android:layout_below="@id/tv_totalsavings"
                    android:layout_marginVertical="10dp"
                    android:background="@color/colorGreyVerylight" />

                <RelativeLayout
                    android:id="@+id/btn_buynow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/v_line6"
                    android:paddingTop="@dimen/dimen_10dp"
                    android:paddingBottom="@dimen/dimen_10dp"
                    android:layout_marginBottom="@dimen/dimen_10dp">

                    <TextView
                        android:id="@+id/tv_footertotal"
                        style="@style/txt_style_heading4d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:textColor="@color/colorBlack"
                        android:layout_marginLeft="10dp"
                        android:textStyle="bold"
                        android:text=""
                        android:visibility="gone"
                         />

                    <TextView
                        android:id="@+id/tv_footertotalitem"
                        style="@style/txt_style_heading6d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_below="@id/tv_footertotal"
                        android:textColor="@color/colorBlack"
                        android:layout_marginLeft="10dp"
                        android:textStyle="bold"
                        android:text=""
                        android:visibility="gone"
                        />
                    <TextView
                        android:id="@+id/tv_placeorder"
                        style="@style/txt_style_heading4d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:textColor="@color/colorYellow"
                        android:background="@drawable/button_selector"
                        android:paddingLeft="@dimen/dimen_20dp"
                        android:paddingRight="@dimen/dimen_20dp"
                        android:paddingTop="@dimen/dimen_10dp"
                        android:paddingBottom="@dimen/dimen_10dp"
                        android:layout_marginHorizontal="@dimen/dimen_10dp"
                        android:gravity="center"
                        android:drawableTint="@color/colorYellow"
                        android:textStyle="bold"
                        android:text="PLACE ORDER"
                        />

                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>

    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:layout_alignParentBottom="true"
        >

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigatin_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:background="@drawable/drop_shadow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:itemIconSize="22dp"
            app:elevation="8dp"
            app:labelVisibilityMode="labeled"
            app:itemTextColor="@color/colorPrimaryDark"
            app:menu="@menu/bottom_navigation_menu"/>



    </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>