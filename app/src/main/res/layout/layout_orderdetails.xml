<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:cardElevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/rl_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:layout_marginVertical="20dp">


                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="120dp"
                    android:layout_height="100dp"
                    android:padding="4dp"
                    android:src="@drawable/advirahealnew" />

                <ImageView
                    android:id="@+id/iv_rx"
                    android:layout_width="12dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="-3dp"
                    android:layout_marginLeft="-7dp"
                    android:layout_alignParentTop="true"
                    android:layout_toEndOf="@+id/imageView"
                    android:src="@drawable/rx" />
                <TextView
                    android:id="@+id/tv_productname"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/iv_rx"
                    android:textStyle="bold"
                    android:text="ADVINAC-SP" />
                <TextView
                    android:id="@+id/tv_composition"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_productname"
                    android:layout_toRightOf="@id/imageView"
                    android:visibility="gone"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginTop="2dp"
                    android:text="Composition : " />
                <TextView
                    android:id="@+id/textViewShortDesc"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_below="@id/tv_composition"
                    android:layout_marginHorizontal="5dp"
                    android:layout_toRightOf="@id/imageView"
                    android:text="Aceclofenac IP 100 mg
Paracetamol IP 325 mg
Serratippeptidase IP 15 mg" />

                <TextView
                    android:id="@+id/tv_pack"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:layout_toRightOf="@id/imageView"
                    android:layout_below="@id/tv_productname"
                    android:text="Strip 10 Tab" />

                <TextView
                    android:id="@+id/tv_mrp"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_pack"
                    android:layout_marginLeft="5dp"
                    android:layout_toRightOf="@id/imageView"
                    android:text="Rate : ₹ "
                    />

                <TextView
                    android:id="@+id/tv_prodid"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_boxsize"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_unitid"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />


                <TextView
                    android:id="@+id/tv_mrpval"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_pack"
                    android:layout_toRightOf="@id/tv_mrp"
                    android:text="80.00"
                    />

                <TextView
                    android:id="@+id/tv_discount"
                    style="@style/txt_style_heading6m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_pack"
                    android:layout_marginLeft="4dp"
                    android:layout_toRightOf="@+id/tv_price"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="8dp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:id="@+id/tv_inr"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_pack"
                    android:layout_toRightOf="@id/tv_mrpval"
                    android:text=" ₹"
                    android:visibility="gone"
                    />

                <TextView
                    android:id="@+id/tv_price"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_pack"
                    android:layout_marginLeft="@dimen/dimen_2dp"
                    android:layout_toRightOf="@id/tv_inr"
                    android:text="64.00" />

                <TextView
                    android:id="@+id/tv_orderqty"
                    style="@style/txt_style_heading6d"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_mrp"
                    android:layout_marginLeft="5dp"
                    android:layout_toRightOf="@id/imageView"
                    android:text="Ordered Qty : 100" />

                <TextView
                    android:id="@+id/tv_itemprice"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_orderqty"
                    android:layout_marginLeft="5dp"
                    android:layout_toRightOf="@+id/imageView"
                    android:text="Total Amount : ₹ " />

                <TextView
                    android:id="@+id/tv_itempriceval"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_below="@+id/tv_orderqty"
                    android:layout_toRightOf="@+id/tv_itemprice"
                    android:text="64.00"
                    android:textStyle="bold" />

            </RelativeLayout>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>