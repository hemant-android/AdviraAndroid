<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_order"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/rl_prod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <TextView
                    android:id="@+id/tv_orderid"
                    style="@style/txt_style_heading6l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_orderno"
                    style="@style/txt_style_heading6l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/dimen_5dp"
                    android:text=""
                    android:textColor="@color/colorGreymidlight"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tv_total_items"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_orderno"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:text="Items: 3" />

                <TextView
                    android:id="@+id/tv_total_orderval"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_total_items"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:text="Total: ₹ 1000" />


                <TextView
                    android:id="@+id/tv_status"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_total_orderval"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:text="Ordered" />

                <TextView
                    android:id="@+id/tv_paymentstatus"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_status"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:text="Payment : Success" />

                <TextView
                    android:id="@+id/tv_paymentmode"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_status"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:text=" " />


                <ImageView
                    android:id="@+id/iv_status"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_below="@+id/tv_paymentstatus"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/ic_calender_24dp" />

                <TextView
                    android:id="@+id/tv_deliv"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_paymentstatus"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    android:layout_toRightOf="@id/iv_status"
                    android:text="Thu, 14 FEb 2019"
                    android:textColor="@color/colorGreymidlight" />


                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="120dp"
                    android:layout_height="100dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:padding="4dp"
                    android:src="@drawable/advirahealnew"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/paynowcod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_status"
                    android:layout_alignParentRight="true"
                    android:layout_margin="5dp"
                    android:background="@drawable/border_grey_color_transparent"
                    android:backgroundTint="@color/colorPrimary"
                    android:padding="@dimen/dimen_10dp"
                    android:text="Pay Now"
                    android:textColor="@color/colorYellow"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </RelativeLayout>

            <View
                android:id="@+id/v_line8"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/rl_prod"
                android:layout_centerHorizontal="true"
                android:background="@color/colorGreyVerylight" />

            <TextView
                android:id="@+id/tv_cancelorder"
                style="@style/txt_style_heading5d"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:layout_below="@id/v_line8"
                android:paddingVertical="10dp"
                android:text="Cancel Order"
                android:textColor="@color/colorThemeDark"/>

            <RelativeLayout
                android:id="@+id/rl_retrypayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_cancelorder"
                android:background="@drawable/bg_solid_border_dotted_blue">

                <TextView
                    android:id="@+id/tv_retrypayment"
                    style="@style/txt_style_heading6d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="15dp"
                    android:text="In case your payment is failed and haven’t completed the payment process then you can retry payment to complete your order." />

                <Button
                    android:id="@+id/btn_retrypayment"
                    style="@style/txt_style_heading5d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_retrypayment"
                    android:layout_centerHorizontal="true"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/bg_selected"
                    android:text="RETRY PAYMENT"
                    android:textColor="@color/colorYellow"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tv_retrypaymentfooter"
                    style="@style/txt_style_heading6d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/btn_retrypayment"
                    android:layout_marginBottom="10dp"
                    android:layout_marginHorizontal="15dp"
                    android:text="*Retry option is open for 1 hour. After that order will automatically get cancelled"
                    android:textColor="@color/colorGreymidlight"
                    android:textSize="10dp" />

                <TextView
                    android:id="@+id/tv_cancelhours"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tv_ordercreteddatehour"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_addressid"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_address"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_ordertype"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_totalamount"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_totaltax"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_totaldiscount"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>


            </RelativeLayout>






            <View
                android:id="@+id/v_line7"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/rl_prod"
                android:layout_centerHorizontal="true"
                android:background="@color/colorGreylight"
                android:visibility="gone" />


            <RatingBar
                android:id="@+id/RatingBar"
                style="?android:attr/ratingBarStyleIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/v_line7"
                android:layout_centerHorizontal="true"
                android:layout_marginVertical="10dp"
                android:numStars="5"
                android:theme="@style/RatingBar"
                android:visibility="gone" />
        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>