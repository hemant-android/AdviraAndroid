<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.forgotpassword.ForgotPasswordActivity">

    <RelativeLayout
        android:id="@+id/rl_signup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header">

        <RelativeLayout
            android:id="@+id/rl_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_effect"
            android:paddingLeft="5dp"
          >

            <ImageView
                android:id="@+id/iv_signup_header"
                style="@style/txt_style_heading1l"
                android:layout_width="@dimen/dimen_20dp"
                android:layout_height="@dimen/dimen_20dp"
                android:layout_marginHorizontal="@dimen/dimen_15dp"
                android:layout_marginVertical="16dp"
                android:src="@drawable/ic_arrow_back_24dp" />
        </RelativeLayout>


        <TextView
            android:id="@+id/tv_signup_header2"
            style="@style/txt_style_heading4d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingBottom="@dimen/dimen_2dp"
             android:layout_toRightOf="@id/rl_back"
            android:textColor="@color/colorPrimaryDark"
            android:textStyle="bold"
            android:text="@string/action_forgotpass" />
    </RelativeLayout>


    <ScrollView
        android:id="@+id/rl_signup2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rl_signup"
        android:layout_centerVertical="true"
        android:layout_marginBottom="70dp">

        <RelativeLayout
        android:id="@+id/rl_loginmain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/rl_signup"
        android:layout_marginHorizontal="25dp">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="265dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:layout_centerHorizontal="true"
            android:src="@drawable/advirahealnew"
           />

        <RelativeLayout
            android:id="@+id/rl_login2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_logo"
            android:layout_marginTop="5dp">

        <TextView
            android:id="@+id/tv_signu"
            style="@style/txt_style_heading2l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:textSize="28sp"
            android:textStyle="bold"
            android:text="@string/action_forgotpass"
            android:textColor="@color/colorBlack" />

        <TextView
            android:id="@+id/tv_login_header2"
            style="@style/txt_style_heading4l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_signu"
            android:layout_marginTop="25dp"
            android:text="@string/fp_header"
            android:textColor="@color/colorBlack" />


            <EditText
                android:id="@+id/et_mobileno"
                style="@style/txt_style_heading4l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_login_header2"
                android:layout_marginTop="@dimen/dimen_35dp"
                android:autofillHints="@string/prompt_email"
                android:drawablePadding="5dp"
                android:hint="@string/su_mobile"
                android:gravity="center"
                android:inputType="number"
                android:padding="@dimen/dimen_15dp"
                android:layout_marginBottom="@dimen/dimen_20dp"
                android:background="@drawable/editbox_selector"
                android:maxLength="11" />



        </RelativeLayout>
    </RelativeLayout>
    </ScrollView>
    <RelativeLayout
        android:id="@+id/rl_footer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/dimen_25dp"
        >

        <Button
            android:id="@+id/btn_continue"
            style="@style/txt_style_heading2l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_selector"
            android:gravity="center"
            android:text="Reset"
            android:textSize="14sp"
            android:textColor="@color/colorYellow"
            android:textStyle="bold"/>

    </RelativeLayout>
</RelativeLayout>
