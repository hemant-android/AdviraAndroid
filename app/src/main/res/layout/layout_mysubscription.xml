<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_subs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/rl_prod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_subsid"
                    style="@style/txt_style_heading6l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_orderno"
                    style="@style/txt_style_heading6l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="5dp"
                    android:paddingVertical="5dp"
                    android:text="#1011121"
                    android:textColor="@color/colorGreymidlight" />


                <TextView
                    android:id="@+id/tv_itemCount"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_orderno"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:text="Items: 3" />

                <TextView
                    android:id="@+id/tv_subs_type"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_status"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:text="Total: ₹ 1000" />


                <TextView
                    android:id="@+id/tv_status"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_itemCount"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:text="Ordered" />

                <TextView
                    android:id="@+id/tv_paymentstatus"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_subs_type"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:text="Payment : Success"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_paymentmode"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_status"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:text=" "
                    android:visibility="gone" />


                <ImageView
                    android:id="@+id/iv_status"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_below="@+id/tv_paymentstatus"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/ic_calender_24dp" />

                <TextView
                    android:id="@+id/tv_subsperiod"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_paymentstatus"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    android:layout_toRightOf="@id/iv_status"
                    android:text="Thu, 14 FEb 2019"
                    android:textColor="@color/colorGreymidlight" />


                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="120dp"
                    android:layout_height="100dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:padding="4dp"
                    android:src="@drawable/advirahealnew"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/paynowcod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_status"
                    android:layout_alignParentRight="true"
                    android:layout_margin="5dp"
                    android:background="@drawable/border_grey_color_transparent"
                    android:backgroundTint="@color/colorPrimary"
                    android:padding="@dimen/dimen_10dp"
                    android:text="Pay Now"
                    android:textColor="@color/colorYellow"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_edit"
                    android:layout_width="30dp"
                    android:layout_height="@dimen/dimen_30dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginStart="@dimen/dimen_5dp"
                    android:layout_marginTop="@dimen/dimen_5dp"
                    android:layout_marginEnd="@dimen/dimen_5dp"
                    android:layout_marginBottom="@dimen/dimen_5dp"
                    android:background="@drawable/ic_edit_black_icon_profile" />


            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewexp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_prod"
                android:layout_marginTop="@dimen/dimen_5dp"/>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>