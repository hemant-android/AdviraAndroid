<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorWhite"
    tools:context=".ui.forgotpassword.ForgotPasswordDoneActivity">

    <RelativeLayout
        android:id="@+id/rl_otp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header">


        <TextView
            android:id="@+id/tv_signup_header2"
            style="@style/txt_style_heading4d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginVertical="15dp"
            android:text="Password Changed"
            android:textStyle="bold"
            android:textColor="@color/colorPrimaryDark"/>

    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_loginmain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/rl_otp"
        android:layout_marginHorizontal="25dp"
        android:layout_marginVertical="@dimen/dimen_10dp">


        <RelativeLayout
            android:id="@+id/rl_login2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorWhite">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="225dp"
                android:layout_height="75dp"
                android:layout_marginTop="20dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/advirahealnew"
                android:visibility="gone"/>


            <ImageView
                android:id="@+id/tv_circle"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="150dp"
                android:background="@drawable/changepassword_done"
                />


            <ImageView
                android:id="@+id/chk"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_centerInParent="true"
                android:layout_marginTop="@dimen/dimen_20dp"
                android:contentDescription="@null"
                android:src="@drawable/animated_vector_check"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_msg"
                style="@style/txt_style_heading4d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_circle"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/montserrat"
                android:gravity="center"
                android:text="@string/fp_donemsg" />


            <Button
                android:id="@+id/btn_continueshopping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_msg"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="85dp"
                android:text="Proceed To Login"
                android:textColor="@color/colorYellow"
                android:background="@drawable/button_selector"
                style="@style/txt_style_heading2d"
                android:textStyle="bold"/>


        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
