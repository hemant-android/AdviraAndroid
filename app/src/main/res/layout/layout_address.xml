<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="5dp"
        android:padding="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <RelativeLayout
                android:id="@+id/rl_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_grey_color_transparent">


                <RadioButton
                    android:id="@+id/rb_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="7dp"
                    android:layout_alignTop="@+id/tv_addtype"
                    android:layout_marginStart="5dp"
                    />
                <TextView
                    android:id="@+id/tv_addid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_druglic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_druglicexpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>



                <TextView
                    android:id="@+id/tv_adddefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_addname"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="150dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:layout_marginTop="@dimen/dimen_5dp"
                    android:layout_marginLeft="10dp"
                    android:layout_below="@id/rb_add"
                    android:text=""
                    android:textSize="@dimen/dimen_13dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_addmobile"
                    style="@style/txt_style_heading3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="150dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:layout_marginTop="@dimen/dimen_5dp"
                    android:layout_marginLeft="10dp"
                    android:layout_below="@id/tv_addname"
                    android:text=""
                    android:visibility="gone"
                    android:textSize="@dimen/dimen_13dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_addtype"
                    style="@style/txt_style_heading5d"
                    android:layout_width="80dp"
                    android:layout_height="20dp"
                    android:textAllCaps="true"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="13dp"
                    android:textAlignment="center"
                    android:layout_toRightOf="@id/tv_addname"
                    android:visibility="gone"
                    android:paddingHorizontal="5dp"
                    android:text="Office"
                    android:textStyle="bold"/>

                <RelativeLayout
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"  >

                    <RelativeLayout
                        android:id="@+id/rl_delete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect"
                        android:paddingLeft="5dp"
                        android:paddingRight="10dp">

                        <ImageView
                            android:id="@+id/iv_delete"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tint="@color/colorRed"
                            android:layout_marginLeft="15dp"
                            android:layout_marginVertical="10dp"
                            android:src="@drawable/ic_delete_24dp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rl_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect"
                        android:layout_alignParentRight="true"
                        android:paddingLeft="5dp"
                        android:paddingRight="10dp">

                        <ImageView
                            android:id="@+id/iv_edit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp"
                            android:layout_marginVertical="10dp"
                            android:tint="@color/colorPurple"
                            android:src="@drawable/ic_edit_24dp" />
                    </RelativeLayout>

                </RelativeLayout>


                <TextView
                    android:id="@+id/tv_addressline1"
                    style="@style/txt_style_heading6d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_addname"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="@dimen/dimen_5dp"
                    android:text="address line 2 address line 2address line 2address line 2address line 2address line 2" />

                <TextView
                    android:id="@+id/tv_addressline2"
                    style="@style/txt_style_heading6d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_addressline1"
                    android:layout_marginLeft="10dp"
                    android:text="address line" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                </RelativeLayout>
                <TextView
                    android:id="@+id/tv_city"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_below="@id/tv_addressline2"
                    android:layout_marginLeft="30dp"
                    android:textAllCaps="true"
                    android:text="Patna munger"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_state"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginLeft="5dp"
                    android:layout_below="@id/tv_addressline2"
                    android:layout_toRightOf="@id/tv_city"
                    android:textAllCaps="true"
                    android:text="Bihar uttar pradesh"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_cityid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_stateid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_pin"
                    style="@style/txt_style_heading6d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginLeft="5dp"
                    android:layout_below="@id/tv_addressline2"
                    android:layout_toRightOf="@id/tv_state"
                    android:layout_marginBottom="10dp"
                    android:text="852113" />

                <TextView
                    android:id="@+id/tv_fulladdress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_addressline2"
                    android:layout_marginBottom="10dp"
                    android:layout_marginLeft="10dp"
                    style="@style/txt_style_heading6d"
                    android:text="Munger  Bihar uttar pradesh 852113 hghjg hjhg hjgjh h"
                    />


            </RelativeLayout>


        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>