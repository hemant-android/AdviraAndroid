<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorblacktrans"
    app:layout_behavior="@string/bottom_sheet_behavior"
    tools:context=".ui.myaccount.MembershipFragment">

    <!-- TODO: Update blank fragment layout -->
    <RelativeLayout
        android:id="@+id/rl_title"
        android:layout_width="match_parent"
        android:gravity="center"
        android:visibility="gone"
        android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_title"
        style="@style/txt_style_heading3d"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/dimen_5dp"
        android:paddingBottom="@dimen/dimen_5dp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:text="@string/membership_title" />

    <TextView
        android:id="@+id/tv_title1"
        style="@style/txt_style_heading4d"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/membership_title1"
        android:padding="@dimen/dimen_5dp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimaryDark"
        android:layout_toRightOf="@+id/tv_title"/>

        <ImageView
            android:id="@+id/iv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_title"
            android:visibility="gone"
            android:layout_marginVertical="@dimen/dimen_15dp"/>

    </RelativeLayout>

    <View
        android:id="@+id/v_line3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/rl_title"
        android:layout_marginHorizontal="@dimen/dimen_10dp"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:visibility="gone"
        android:background="@color/colorGreymidlight" />

    <RelativeLayout
        android:id="@+id/rl_plan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/v_line3"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dimen_10dp">

        <TextView
            android:id="@+id/tv_chooseplan"
            style="@style/txt_style_heading4d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose your Elite Green Plan"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="@dimen/dimen_5dp"/>

        <RelativeLayout
            android:id="@+id/rl_showplan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_chooseplan"
            android:background="@drawable/bg_corners_border_blue"
            android:layout_marginHorizontal="@dimen/dimen_10dp"
            android:layout_marginTop="@dimen/dimen_5dp"
            >

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_showplan1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginVertical="@dimen/dimen_10dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/bg_corners_border_blue"
                android:clipToPadding="true"
                app:cardCornerRadius="5dp"
                app:cardUseCompatPadding="true"
                android:textAlignment="center"
                >

                <TextView
                    android:id="@+id/tv_plan1"
                    style="@style/txt_style_heading4m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_selected"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/colorYellow"
                    android:padding="@dimen/dimen_10dp"
                    android:text="@string/plan_99"/>

            </androidx.cardview.widget.CardView>

            <View
                android:id="@+id/v_line1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/cv_showplan1"
                android:layout_marginHorizontal="@dimen/dimen_15dp"
                android:background="@color/colorGreymidlight" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_showplan2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginVertical="@dimen/dimen_10dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/bg_corners_border_blue"
                android:clipToPadding="true"
                app:cardCornerRadius="5dp"
                app:cardUseCompatPadding="true"
                android:textAlignment="center"
                android:layout_below="@+id/v_line1"
                >

                <TextView
                    android:id="@+id/tv_plan2"
                    style="@style/txt_style_heading4m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_selected"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/colorYellow"
                    android:padding="@dimen/dimen_10dp"
                    android:text="@string/plan_149"/>

            </androidx.cardview.widget.CardView>


        </RelativeLayout>



    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_benefits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_plan"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dimen_10dp">

        <TextView
            android:id="@+id/tv_benefits"
            style="@style/txt_style_heading4d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Membership Benefits:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="@dimen/dimen_5dp"/>

        <RelativeLayout
            android:id="@+id/rl_benefit1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_benefits"
            android:layout_marginTop="@dimen/dimen_10dp">

            <ImageView
                android:id="@+id/iv_dot1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_baseline_circle_8"
                android:tint="@color/black"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv_dot1"
                android:layout_marginStart="@dimen/dimen_10dp"
                android:textColor="@color/black"
                android:text="Unlimited Free Delivery"/>


        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_benefit2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_benefit1"
            android:layout_marginTop="@dimen/dimen_10dp">

            <ImageView
                android:id="@+id/iv_dot2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_baseline_circle_8"
                android:tint="@color/black"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv_dot2"
                android:layout_marginStart="@dimen/dimen_10dp"
                android:textColor="@color/black"
                android:text="Privileged access of Delivery Slot"/>


        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_benefit3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_benefit2"
            android:layout_marginTop="@dimen/dimen_10dp">

            <ImageView
                android:id="@+id/iv_dot3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_baseline_circle_8"
                android:tint="@color/black"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv_dot3"
                android:layout_marginStart="@dimen/dimen_10dp"
                android:textColor="@color/black"
                android:text="Exclusive bonus offers and deals"/>


        </RelativeLayout>

    </RelativeLayout>

    <View
        android:id="@+id/v_line2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/rl_benefits"
        android:visibility="gone"
        android:layout_marginHorizontal="@dimen/dimen_10dp"
        android:layout_marginVertical="@dimen/dimen_10dp"
        android:background="@color/colorGreymidlight" />

    <RelativeLayout
        android:id="@+id/rl_faqs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_benefits"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dimen_15dp">

        <TextView
            android:id="@+id/tv_faqs"
            style="@style/txt_style_heading4d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Membership FAQ:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="@dimen/dimen_5dp"/>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/bottom_sheet_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp"
        android:background="@drawable/rounded_dialog"
        android:layout_marginHorizontal="10dp"
        >

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_benefit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:layout_marginHorizontal="@dimen/dimen_10dp"
        />

    <RelativeLayout
        android:id="@+id/btn_buynow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dimen_5dp"
        android:elevation="4dp"
        android:layout_marginHorizontal="@dimen/dimen_10dp"
        android:layout_marginVertical="@dimen/dimen_10dp"
        android:layout_below="@+id/rv_benefit"
        android:background="@drawable/button_selector"
        >

        <TextView
            android:id="@+id/tv_footertotal"
            style="@style/txt_style_heading5l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:textColor="@color/colorYellow"
            android:layout_marginLeft="15dp"
            android:text=""
            android:visibility="gone"
            />

        <TextView
            android:id="@+id/tv_duration"
            style="@style/txt_style_heading5l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@id/tv_footertotal"
            android:textColor="@color/colorYellow"
            android:layout_marginLeft="15dp"
            android:text=""
            android:visibility="gone"
            />

        <TextView
            android:id="@+id/tv_buyplan"
            style="@style/txt_style_heading4d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginHorizontal="@dimen/dimen_10dp"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:padding="@dimen/dimen_5dp"
            android:textColor="@color/colorYellow"
            android:text="Continue"
            android:textStyle="bold"
            android:textAllCaps="false"
            />

    </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>