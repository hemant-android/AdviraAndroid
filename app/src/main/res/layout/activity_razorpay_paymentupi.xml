<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent" >
    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header">

        <RelativeLayout
            android:id="@+id/rl_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_effect"
            android:paddingLeft="5dp"
            >

            <ImageView
                android:id="@+id/iv_newadd_header"
                android:layout_width="@dimen/dimen_20dp"
                android:layout_height="@dimen/dimen_20dp"
                android:layout_marginVertical="16dp"
                android:layout_marginHorizontal="@dimen/dimen_15dp"
                android:src="@drawable/ic_arrow_back_24dp" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/iv_headerlogo"
            style="@style/txt_style_heading1l"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_toRightOf="@id/rl_back"
            android:layout_marginLeft="10dp"
            android:layout_marginVertical="15dp"
            android:src="@drawable/splash_logo"
            android:visibility="gone"/>


        <TextView
            android:id="@+id/tv_newadd_header2"
            style="@style/txt_style_heading4d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingBottom="@dimen/dimen_2dp"
            android:layout_toRightOf="@id/iv_headerlogo"
            android:text="UPI Payment"
            android:textColor="@color/colorPrimaryDark"/>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_chooseapp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rl_header"
        android:background="@color/colorWhite"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_chooseapptopay"
            style="@style/txt_style_heading3d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="20dp"
            android:background="@drawable/button_selector"
            android:text="Choose a UPI App to Pay"
            android:textColor="@color/colorWhite"
             />
    </RelativeLayout>



    <TextView
        android:id="@+id/tv_vpa"
        style="@style/txt_style_heading5d"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/rl_chooseapp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="50dp"
        android:text="Enter UPI ID to Pay"
        android:visibility="gone"/>


    <EditText
        android:id="@+id/et_vpa"
        style="@style/txt_style_heading5d"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="40dp"
        android:layout_marginHorizontal="10dp"
        android:layout_below="@id/tv_vpa"
        android:layout_marginTop="10dp"
        android:background="@drawable/border_grey_color_transparent"
        android:hint="Enter your VPA/UPI ID"
        android:paddingHorizontal="10dp" />

    <TextView
        android:id="@+id/tv_vpalbl"
        style="@style/txt_style_heading6d"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_below="@id/et_vpa"
        android:layout_marginLeft="10dp"
        android:text="A collect request notification will be sent to this UPI ID"
        android:textColor="@color/colorGreymidlight"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_vpalbl"
        android:background="@color/colorWhite"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_vpapay"
            style="@style/txt_style_heading3d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="20dp"
            android:background="@drawable/button_selector"
            android:text="Pay with VPA"
            android:textColor="@color/colorWhite"
            android:textStyle="bold" />
    </RelativeLayout>

    <WebView
        android:id="@+id/payment_webview"
        android:visibility="gone"
        android:layout_below="@id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </WebView>

</RelativeLayout>