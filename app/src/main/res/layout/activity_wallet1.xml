<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".ui.myaccount.WalletFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_showbalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="15dp"
        android:background="@color/white"
        android:clipToPadding="true"
        app:cardCornerRadius="5dp"
        app:cardUseCompatPadding="true">

        <RelativeLayout
            android:id="@+id/rl_walletbalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginHorizontal="@dimen/dimen_10dp"
            android:layout_marginVertical="@dimen/dimen_10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="0dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_wallettxt1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="5dp"
                android:text="Wallet balance is:"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/tv_wallettxt1"
                android:layout_alignParentRight="true"
                android:padding="5dp"
                android:text=""
                android:textColor="@color/black"
                android:gravity="right"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_epoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_wallettxt1"
                android:layout_weight="1"
                android:padding="5dp"
                android:layout_marginTop="@dimen/dimen_10dp"
                android:text="Reward Points is:"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvEbalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:layout_marginTop="@dimen/dimen_10dp"
                android:text=" "
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_toRightOf="@+id/tv_epoint"
                android:layout_below="@+id/tvBalance"
                android:gravity="right"
                android:layout_alignParentRight="true"/>

            <TextView
                android:id="@+id/tv_cashback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_epoint"
                android:layout_weight="1"
                android:padding="5dp"
                android:layout_marginTop="@dimen/dimen_10dp"
                android:text="Cashback is:"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCashback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:layout_marginTop="@dimen/dimen_10dp"
                android:text=" "
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_toRightOf="@+id/tv_cashback"
                android:layout_below="@+id/tvEbalance"
                android:gravity="right"
                android:layout_alignParentRight="true"/>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_addmoney"
        android:layout_below="@+id/cv_showbalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="15dp"
        android:background="@color/white"
        android:clipToPadding="true"
        app:cardCornerRadius="5dp"
        app:cardUseCompatPadding="true">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_wallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_outline_account_balance_wallet_24"
                android:layout_marginTop="@dimen/dimen_5dp"
                android:layout_marginStart="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv_wallet"
                android:text="Add Money in Wallet"
                android:layout_marginTop="@dimen/dimen_5dp"
                android:layout_marginStart="@dimen/dimen_10dp"
                android:textColor="@color/black"
                />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_wallet"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="@dimen/dimen_10dp"
                android:background="@color/colorGreyVerylight"
                android:padding="@dimen/dimen_10dp">

                <TextView
                    android:id="@+id/tv_rslogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ "
                    android:textColor="@color/black"
                    android:layout_centerVertical="true"
                    android:textSize="24sp"/>

                <EditText
                    android:id="@+id/et_rupees"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginStart="@dimen/dimen_10dp"
                    android:layout_toRightOf="@+id/tv_rslogo" />

            </RelativeLayout>
        </RelativeLayout>

    </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:id="@+id/cvAddMoney"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardUseCompatPadding="true"
        android:layout_centerHorizontal="true"
        android:clipToPadding="true"
        android:elevation="10dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/dimen_10dp"
        android:layout_marginBottom="@dimen/dimen_10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:paddingHorizontal="@dimen/dimen_10dp"
            android:background="@drawable/button_selector">

            <TextView
                android:id="@+id/addMoney"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:text="Add Money"
                android:layout_centerInParent="true"
                android:textColor="@color/colorYellow"
                android:textSize="18sp"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>


</RelativeLayout>