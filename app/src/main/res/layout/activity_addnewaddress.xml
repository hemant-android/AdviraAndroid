<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.address.AddNewAddressActivity">

    <RelativeLayout
        android:id="@+id/rl_newadd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header">

        <RelativeLayout
            android:id="@+id/rl_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_effect"
            android:paddingLeft="5dp">

            <ImageView
                android:id="@+id/iv_newadd_header"
                android:layout_width="@dimen/dimen_20dp"
                android:layout_height="@dimen/dimen_20dp"
                android:layout_marginHorizontal="@dimen/dimen_15dp"
                android:layout_marginVertical="16dp"
                android:src="@drawable/ic_arrow_back_24dp" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/iv_headerlogo"
            style="@style/txt_style_heading1l"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginVertical="15dp"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@id/rl_back"
            android:src="@drawable/splash_logo"
            android:visibility="gone" />


        <TextView
            android:id="@+id/tv_newadd_header2"
            style="@style/txt_style_heading4d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/iv_headerlogo"
            android:paddingBottom="@dimen/dimen_2dp"
            android:text="@string/ana_header"
            android:textColor="@color/colorPrimaryDark" />

        <RelativeLayout
            android:id="@+id/rl_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="15dp"
            android:layout_marginRight="20dp"
            android:layout_toLeftOf="@id/rl_cart"
            android:background="@drawable/ripple_effect">

            <ImageView
                android:id="@+id/iv_search"
                style="@style/txt_style_heading1l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_search_button_select"
                android:tint="@color/colorPrimaryDark" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginVertical="15dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/ripple_effect">

            <ImageView
                android:id="@+id/iv_cart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_shopping_cart_24dp"
                android:tint="@color/colorPrimaryDark" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_cartcount"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="-25dp"
            android:layout_toStartOf="@+id/rl_cart"
            android:fontFamily="@font/montserrat"
            android:gravity="center"
            android:textColor="@color/colorRed"
            android:textSize="10dp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/rl_newadd2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/rl_newadd"
        android:layout_centerVertical="true"
        android:layout_marginTop="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="25dp">

            <RelativeLayout
                android:id="@+id/rl_castatecity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/tv_castate"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rs1_state" />

                <RelativeLayout
                    android:id="@+id/rl_castate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_castate"
                    android:background="@drawable/editbox_selector"
                    android:gravity="center"
                    android:padding="@dimen/dimen_10dp">

                <Spinner
                    android:id="@+id/spn_castate"
                    style="@style/txt_style_heading4d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    />
                </RelativeLayout>

                <View
                    android:id="@+id/v_line1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:layout_below="@id/rl_castate"
                    android:background="@color/colorGrey"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_cacity"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rl_castate"
                    android:layout_marginTop="20dp"
                    android:text="@string/rs1_city" />

                <RelativeLayout
                    android:id="@+id/rl_cacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_cacity"
                    android:background="@drawable/editbox_selector"
                    android:gravity="center"
                    android:padding="@dimen/dimen_10dp">

                <Spinner
                    android:id="@+id/spn_cacity"
                    style="@style/txt_style_heading4d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    />

                </RelativeLayout>

                <View
                    android:id="@+id/v_line2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:layout_below="@id/rl_cacity"
                    android:background="@color/colorGrey"
                    android:visibility="gone"/>


                <TextView
                    android:id="@+id/tv_capin"
                    style="@style/txt_style_heading4d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/v_line2"
                    android:layout_marginTop="20dp"
                    android:text="@string/rs1_pincode"
                    />

                <AutoCompleteTextView
                    android:id="@+id/et_capin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_below="@id/tv_capin"
                    android:inputType="number"
                    android:maxLength="6"
                    android:hint="@string/rs1_pincode"
                    android:background="@drawable/editbox_selector"
                    android:gravity="left"
                    android:paddingLeft="@dimen/dimen_15dp"
                    android:padding="@dimen/dimen_10dp"
                    android:textStyle="normal"
                    style="@style/txt_style_heading4d"/>


                <TextView
                    android:id="@+id/tv_flat"
                    style="@style/txt_style_heading4d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_below="@id/et_capin"
                    android:text="@string/rs2_flat"
                    />

                <EditText
                    android:id="@+id/et_flat"
                    style="@style/txt_style_heading4d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_flat"
                    android:layout_marginTop="10dp"
                    android:autofillHints="@string/rs1_flat"
                    android:background="@drawable/editbox_selector"
                    android:gravity="left"
                    android:hint="@string/rs1_flat"
                    android:maxLength="100"
                    android:padding="@dimen/dimen_10dp"
                    android:textSize="@dimen/dp_16" />

                <TextView
                    android:id="@+id/tv_street"
                    style="@style/txt_style_heading4d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/et_flat"
                    android:layout_marginTop="20dp"
                    android:text="@string/rs2_street" />

                <EditText
                    android:id="@+id/et_street"
                    style="@style/txt_style_heading4d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_street"
                    android:layout_marginTop="10dp"
                    android:autofillHints="@string/rs1_street"
                    android:background="@drawable/editbox_selector"
                    android:gravity="left"
                    android:hint="@string/rs1_street"
                    android:maxLength="100"
                    android:padding="@dimen/dimen_10dp" />
                <TextView
                    android:id="@+id/tv_username"
                    style="@style/txt_style_heading4d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/et_street"
                    android:layout_marginTop="20dp"
                    android:text="@string/ana_user" />

                <EditText
                    android:id="@+id/et_username"
                    style="@style/txt_style_heading4d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_username"
                    android:layout_marginTop="10dp"
                    android:autofillHints="@string/ana_user"
                    android:background="@drawable/editbox_selector"
                    android:gravity="left"
                    android:hint="@string/ana_user"
                    android:inputType="text"
                    android:maxLength="20"
                    android:padding="@dimen/dimen_10dp" />

                <TextView
                    android:id="@+id/tv_mobileno"
                    style="@style/txt_style_heading4d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/et_username"
                    android:layout_marginTop="20dp"
                    android:text="@string/ana_mobile" />

                <EditText
                    android:id="@+id/et_mobileno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_mobileno"
                    android:maxLength="10"
                    android:inputType="number"
                    android:layout_marginTop="10dp"
                    android:autofillHints="@string/ana_mobile"
                    android:hint="@string/ana_mobile"
                    style="@style/txt_style_heading4d"
                    android:background="@drawable/editbox_selector"
                    android:gravity="left"
                    android:padding="@dimen/dimen_10dp"/>

                <TextView
                    android:id="@+id/tv_makedefault"
                    style="@style/txt_style_heading4d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_below="@id/et_mobileno"
                    android:layout_marginTop="20dp"
                    android:text="@string/ana_makedefault" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/toggle_default"
                    style="@style/txt_style_heading5d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_alignParentRight="true"
                    android:layout_below="@id/et_mobileno"
                    android:layout_marginTop="20dp"
                    android:checked="true" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/et_mobileno"
                    android:layout_marginTop="110dp"
                    android:layout_alignParentBottom="true"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_cancel"
                        style="@style/txt_style_heading4d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_selector"
                        android:text="@string/ana_cancel"
                        android:textColor="@color/colorYellow"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_save"
                        style="@style/txt_style_heading4d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:textColor="@color/colorYellow"
                        android:layout_weight="1"
                        android:background="@drawable/button_selector"
                        android:text="@string/ana_save"
                        android:textStyle="bold" />

                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>