<?xml version="1.0" encoding="utf-8"?><!-- Use DrawerLayout as root container for activity -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout_id"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.navigation.MainActivityNav"
    tools:openDrawer="start">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbarlayout_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            android:fitsSystemWindows="true"
            android:background="@color/colorWhite">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentInsetLeft="0dp"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                app:elevation="0dp"
                app:layout_scrollFlags="scroll|enterAlways">

                <RelativeLayout
                    android:id="@+id/rl_header1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    >

                    <RelativeLayout
                        android:id="@+id/rl_delivpinto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_deliv"
                            style="@style/txt_style_heading1l"
                            android:layout_width="@dimen/dimen_20dp"
                            android:layout_height="@dimen/dimen_20dp"
                            android:layout_marginTop="5dp"
                            android:src="@drawable/place_24px" />

                        <TextView
                            android:id="@+id/tv_deliverto"
                            style="@style/txt_style_heading4d"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dimen_10dp"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="@dimen/dimen_2dp"
                            android:layout_toRightOf="@id/iv_deliv"
                            android:drawableTint="@color/colorBlack"
                            android:text="Select Location"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_delivto2"
                            style="@style/txt_style_heading1l"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:layout_toRightOf="@id/tv_deliverto"
                            android:src="@drawable/ic_arrow_down_blue_24dp"
                            android:tint="@color/colorPrimaryDark"
                            android:visibility="gone" />

                    </RelativeLayout>

                    <ImageView
                        android:id="@+id/iv_headerlogo"
                        style="@style/txt_style_heading1l"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginTop="5dp"
                        android:visibility="gone"/>

                    <ImageView
                        android:id="@+id/iv_headerlogo2"
                        style="@style/txt_style_heading1l"
                        android:layout_width="75dp"
                        android:layout_height="25dp"
                        android:layout_marginTop="5dp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tv_header"
                        style="@style/txt_style_heading4d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="74dp"
                        android:layout_marginTop="5dp"
                        android:layout_toRightOf="@id/iv_headerlogo"
                        android:textColor="@color/colorBlack"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tv_headernew"
                        style="@style/txt_style_heading4d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorPrimaryDark"
                        android:visibility="gone"
                        />

                    <RelativeLayout
                        android:id="@+id/rl_cart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect"
                        android:layout_toLeftOf="@id/rl_search"
                        android:layout_marginRight="15dp"
                        android:layout_marginTop="7dp">

                        <ImageView
                            android:id="@+id/img_cart"
                            style="@style/txt_style_heading1l"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_shopping_cart_24dp"
                            android:tint="@color/colorPrimaryDark" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rl_profile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect"
                        android:layout_toLeftOf="@id/rl_search"
                        android:layout_marginRight="10dp"
                        android:layout_marginTop="8dp">
                        <ImageView
                            android:id="@+id/img_profile"
                            style="@style/txt_style_heading1l"
                            android:layout_width="@dimen/dimen_20dp"
                            android:layout_height="@dimen/dimen_20dp"
                            android:src="@drawable/ic_profile"

                            android:tint="@color/colorPrimaryDark"/>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tv_notificationcount"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginRight="-25dp"
                        android:layout_toStartOf="@+id/rl_notification"
                        android:fontFamily="@font/montserrat"
                        android:gravity="center"
                        android:textColor="@color/colorRed"
                        android:textSize="10dp"
                        android:textStyle="bold" />


                    <RelativeLayout
                        android:id="@+id/rl_search"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect"
                        android:layout_toLeftOf="@id/rl_notification"
                        android:layout_marginRight="15dp"
                        android:layout_marginTop="7dp">
                        <ImageView
                            android:id="@+id/iv_search"
                            style="@style/txt_style_heading1l"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_search_button_select"
                            android:tint="@color/colorPrimaryDark"
                            android:visibility="gone"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rl_notification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/ripple_effect"
                        >

                        <ImageView
                            android:id="@+id/img_notification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_baseline_notifications_24_new"
                            />

                    </RelativeLayout>
                    <TextView
                        android:id="@+id/tv_cartcount"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginRight="-25dp"
                        android:layout_toStartOf="@+id/rl_cart"
                        android:fontFamily="@font/montserrat"
                        android:gravity="center"
                        android:textColor="@color/colorRed"
                        android:textSize="10dp"
                        android:textStyle="bold"/>
                    <RelativeLayout
                        android:id="@+id/rl_header2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_below="@id/iv_headerlogo2">
                        <TextView
                            android:id="@+id/tv_deliverto2"
                            android:textColor="#000"
                            style="@style/txt_style_heading6d"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableTint="@color/colorBlack"
                            android:layout_marginTop="5dp" />
                        <ImageView
                            android:id="@+id/iv_delivto22"
                            style="@style/txt_style_heading1l"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toRightOf="@id/tv_deliverto2"
                            android:layout_marginTop="3dp"
                            android:tint="@color/colorBlack"
                            android:src="@drawable/ic_arrow_down_blue_24dp" />

                    </RelativeLayout>
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:id="@+id/framelayout_id"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/appbarlayout_id"
            android:layout_marginBottom="@dimen/dp_56" />

    </RelativeLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"

        >

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigatin_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:background="@drawable/drop_shadow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/colorGreymidlight"
            app:elevation="8dp"
            app:labelVisibilityMode="labeled"
            app:itemTextColor="@color/colorPrimaryDark"
            app:menu="@menu/bottom_navigation_menu"/>



    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Container for contents of drawer - use NavigationView to make configuration easier -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationview_id"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_layout"
        app:itemIconTint="@color/colorPrimaryDark"
        app:itemTextColor="@color/colorPrimaryDark"
        app:menu="@menu/nav_drawer_menu"
        />


</androidx.drawerlayout.widget.DrawerLayout>